;; angle-mod: the ISO key (a.k.a. LSGT or 102 key) becomes Z

(defsrc
  1    2    3    4    5    6    7    8    9    0    bspc
  q    w    e    r    t         y    u    i    o    p
  a    s    d    f    g         h    j    k    l    ;
  <    z    x    c    v    b    n    m    ,    .    /
            lalt          spc             ralt
)

(defchordsv2
	(z     x)  esc   20 first-release ()
	(x  lalt)  @func 20 all-released ()
	;; following are right anglemod specific
	(i     o)  ret   20 first-release ()
	(,  ralt)  @mou  20 all-released ()
)

;; vim: set ft=lisp
