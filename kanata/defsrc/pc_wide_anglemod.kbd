;; wide-angle-mod:
;; - the ISO key (a.k.a. LSGT or 102 key) becomes Z
;; - the right hand is moved one key to the right

(defsrc
  1    2    3    4    5    6    7    8    9    0    bspc
  q    w    e    r    t         u    i    o    p    [
  a    s    d    f    g         j    k    l    ;    '
  <    z    x    c    v    b    m    ,    .    /    rsft
            lalt          spc             ralt
)

(defchordsv2
	(z     x)  esc   20 first-release ()
	(x  lalt)  @func 20 all-released ()
	;; following is right anglemod specific
	(o     p)  ret   20 first-release ()
)

;; vim: set ft=lisp
