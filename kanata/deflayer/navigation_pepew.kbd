;; Num-Navigation layer:
;;  - should inherit from NumPad
;;  - left: one-handed shortcuts (Cmd/Ctrl-AZXCV) + Tab/S-Tab
;;  - top: Super-num (i3/sway) or Alt-num (browser)

;; The `lrld` action stands for "live reload". This will re-parse everything
;; except for linux-dev, i.e. you cannot live reload and switch keyboard devices.

(deflayer navigation
  F1    F2    F3    F4    F5    F6    F7    F8    F9    F10   F11   lrld
  caps  home  up    end   pgup  XX    @-    @7    @8    @9    @/
  tab   lft   down  rght  pgdn  XX    @+    @4    @5    @6    @0
  bck   prtsc esc   ins   fwd   XX    XX    @.    @1    @2    @3    @,
              _                 _                 del         _     _
)

(deflayer navigation_azerty
  F1    F2    F3    F4    F5    F6    F7    F8    F9    F10   F11   lrld
  caps  home  up    end   pgup  XX    @-    @b7   @b8   @b9   @/
  tab   lft   down  rght  pgdn  XX    @+    @b4   @b5   @b6   @b0
  bck   prtsc esc   ins   fwd   XX    XX    @.    @b1   @b2   @b3   @,
              _                 _                 del         _     _ 
)

(deflayer shiftnavigation
  F1    F2     F3     F4     F5      F6   F7   F8   F9   F10  F11   lrld
  caps  S-home S-up   S-end  S-pgup  XX   @-   @&   @*   @#   @/
  S-tab S-lft  S-down S-rght S-pgdn  XX   @+   @$   @%   @^   @@
  bck   prtsc  esc    S-ins  fwd     XX   XX   @.   @€   @«   @»    @,
               _                     _              S-del     _     _
)

;; vim: set ft=lisp
