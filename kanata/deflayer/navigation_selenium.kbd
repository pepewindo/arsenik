;; Num-Navigation layer:
;;  - should inherit from NumPad
;;  - left: one-handed shortcuts (Cmd/Ctrl-AZXCV) + Tab/S-Tab
;;  - top: Super-num (i3/sway) or Alt-num (browser)

;; The `lrld` action stands for "live reload". This will re-parse everything
;; except for linux-dev, i.e. you cannot live reload and switch keyboard devices.

(defalias 
  fun (tap-hold $tap_timeout $long_hold_timeout  spc  (layer-while-held func))
)

(deflayer navigation
  M-1  M-2  M-3  M-4  M-5  lrld M-6  M-7  M-8  M-9  M-0
  esc  home up   end  pgup      @/   @7   @8   @9   @run
  @all lft  down rght pgdn      @-   @4   @5   @6   @0
  @ndo @cut @cpy @pst @rdo  _   @,   @1   @2   @3   @.
      S-tab del            @fun           esc
)

(deflayer func
  M-1  M-2  M-3  M-4  M-5  lrld M-6  M-7  M-8  M-9  M-0
  F1   F2   F3   F4   _         _    prev volu _    _
  F5   F6   F7   F8   _         _   🔣▶⏸  mute ⇭    prtsc
  F9   F10  F11  F12  _     _   _    next vold _    _
      S-tab del             _             _
)

;; vim: set ft=lisp
