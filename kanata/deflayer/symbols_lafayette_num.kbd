;; Symbol layers: Lafayette/Ergo‑L AltGr programmation layer

(defalias
  num  (layer-toggle numrow)
  numl (layer-switch numlock)
  base (layer-switch base)
)

;; main symbols layer aliases
(defalias

  ;; subscript digits
  ₁ (unicode ₁)
  ₂ (unicode ₂)
  ₃ (unicode ₃)
  ₄ (unicode ₄)
  ₅ (unicode ₅)
  ₆ (unicode ₆)
  ₇ (unicode ₇)
  ₈ (unicode ₈)
  ₉ (unicode ₉)
  ₀ (unicode ₀)

  ^ (unicode ^)
  < (unicode <)
  > (unicode >)
  $ (unicode $)
  % (unicode %)
  @ (unicode @)
  & (unicode &)
  * (unicode *)
  ' (unicode ')
  ` (unicode `)

  { (unicode {)
  pl (unicode r#"("#)  ;; (
  pr (unicode r#")"#)  ;; )
  } (unicode })
  = (unicode =)
  \ (unicode \)
  + (unicode +)
  - (unicode -)
  / (unicode /)
  '' (unicode r#"""#)  ;; "

  ~ (unicode ~)
  [ (unicode [)
  ] (unicode ])
  _ (unicode _)
  # (unicode #)
  | (unicode |)
  ! (unicode !)
  ; (unicode ;)
  : (unicode :)
  ? (unicode ?)
)

;; shifted symbols layer aliases
(defalias
  ;; superscript digits
  ¹ (unicode ¹)
  ² (unicode ²)
  ³ (unicode ³)
  ⁴ (unicode ⁴)
  ⁵ (unicode ⁵)
  ⁶ (unicode ⁶)
  ⁷ (unicode ⁷)
  ⁸ (unicode ⁸)
  ⁹ (unicode ⁹)
  ⁰ (unicode ⁰)

  ;; TODO: dead ^
  ≤ (unicode ≤)
  ≥ (unicode ≥)
  ;; TODO: dead ¤
  ;; TODO: dead ˚
  × (unicode ×)
  ;; TODO: dead '
  ;; TODO: dead `

  ;; TODO: dead ˇ
  ;; TODO: dead ˙
  ≠ (unicode ≠)
  ;; TODO: dead /
  ± (unicode ±)
  ;; TODO: dead ˉ
  ÷ (unicode ÷)
  ;; TODO: dead ˝

  ;; TODO: dead ~
  ;; TODO: dead ,
  ;; TODO: dead ˛
  ¦ (unicode ¦)
  ¬ (unicode ¬)
  ;; TODO: dead ¸
  ;; TODO: dead ˘
)

;; numrow layer layer aliases
(defalias
  ′ (unicode ′)
  ″ (unicode ″)
) 

(deflayer symbols
  @₁   @₂   @₃   @₄   @₅   @₆   @₇   @₈   @₉   @₀   XX
  @^   @<   @>   @$   @%        @@   @&   @*   @'   @`
  @{   @pl  @pr  @}   @=        @\   @+   @-   @/   @''
  @~   @[   @]   @_   @#   XX   @|   @!   @;   @:   @?
            @num           spc            ret
)

;; Numrow layer

(deflayer numrow
  @¹   @²   @³   @⁴   @⁵   @⁶   @⁷   @⁸   @⁹   @⁰   bspc
  @€   @«   @»   @$   @%        @^   @&   @*   @#   @@
  @1   @2   @3   @4   @5        @6   @7   @8   @9   @0
  @°   @″   @′   h    @/  @numl @.   @+   @-   @,   @:
            _             @nbs            bspc
)

(deflayer numlock
  @¹   @²   @³   @⁴   @⁵   @⁶   @⁷   @⁸   @⁹   @⁰   bspc
  @€   @«   @»   @$   @%        @^   @&   @*   @#   @@
  @1   @2   @3   @4   @5        @6   @7   @c8   @9   @s0
  @ndo @cpy @cut @pst @/   bspc @.   @+   @-   @,   @:
            @base          @nav           @sym
)

(defalias
  s0 (tap-hold $tap_timeout $long_hold_timeout @0 rsft)
  c8 (tap-hold $tap_timeout $long_hold_timeout @8 rctl)
)

;; vim: set ft=lisp
