(defchordsv2
  (z   x)  esc 20 first-release ()
  (o   p)  ret 20 first-release ()
;;  (i   o)  ret 20 first-release () ;; for simple angle-mod
)

;; Base layer: layer-taps under the thumbs + home-row mods on SDF and JKL
(deflayer base
  _    _    _    _    _  bspc  _    _    _    _    _
  q    w    e    r    t        y    u    i    o    p
  a    @ss  @dd  @ff  g        h    @jj  @kk  @ll  @sh
  z    x    c    v    b C-bspc n    m    ,    .    /
            @osm         @nav      @sym
)

;; Timing variables are defined in `kanata.kbd` file.

(defalias
  mou (layer-switch mousectl)
  cw (caps-word 2000)

  ;; This example is similar to the default caps-word behaviour but it moves the
  ;; `O` (Ergo-L dead key) and `;` (Ergo-L U) keys to the capitalized key list
  ;; from the extra non-terminating key list.
  cwc (caps-word-custom
       2000
       (; , / a b d e f g h i j k l m p q r s t u v w x y z)
       (o c m ; , / bspc del up down left rght)
  )
    
  ;; Main mod-tap: Nav layer when held, Space when tapped.
  nav (tap-hold $tap_timeout $long_hold_timeout spc (layer-while-held navigation))

  ;; Space-cadet thumb keys: Shift/BackSpace, AltGr/Enter.
  ;; Acts as a modifier by default, or as BackSpace/Enter when tapped separately.
  sft (tap-hold-press $tap_timeout $hold_timeout bspc lsft)
  sym (one-shot-press $long_tap_timeout (layer-while-held symbols))

  ;; Shift mods
  ;; osm (tap-dance $long_tap_timeout ( (one-shot-press 2000 lsft)
  ;;                       @cwc) )
  osm (tap-dance
        $long_tap_timeout (
          (one-shot-press $long_tap_timeout lsft)
          (tap-hold-press $tap_timeout $hold_timeout @cwc @mou)
        )
      )

  ;; Home-row mods
  ss (tap-hold $tap_timeout $long_hold_timeout s lmet)
  dd (tap-hold $tap_timeout $long_hold_timeout d lctl)
  ff (tap-hold $tap_timeout $long_hold_timeout f lalt)
  jj (tap-hold $tap_timeout $long_hold_timeout j lalt)
  kk (tap-hold $tap_timeout $long_hold_timeout k rctl)
  sh (tap-hold $tap_timeout $long_hold_timeout ; lsft)
  ll (tap-hold $tap_timeout $long_hold_timeout l rmet)
)

;; vim: set ft=lisp
