;; NumLock layer = `NumNav` without function keys or layer-taps.

(deflayer numlock
  _    _    _    _    _     _   _    _    _    _    _
  @std home up   end  pgup      @/   @7   @8   @9   @std
  tab  lft  down rght pgdn      @-   @4   @5   @6   @0
  @ndo @cut @cpy @pst S-tab _   @.   @1   @2   @3   @,
            sft             @nav     @sym
)

(defalias
  std (layer-switch base)
  lck (layer-switch numlock)
)

;; vim: set ft=lisp:
