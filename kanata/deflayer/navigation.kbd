;; Num-Navigation layer:
;;  - should inherit from NumPad
;;  - left: one-handed shortcuts (Cmd/Ctrl-AZXCV) + Tab/S-Tab
;;  - top: Super-num (i3/sway) or Alt-num (browser)

;; The `lrld` action stands for "live reload". This will re-parse everything
;; except for linux-dev, i.e. you cannot live reload and switch keyboard devices.

(deflayer navigation
  M-1  M-2  M-3  M-4  M-5  lrld M-6  M-7  M-8  M-9  XX
  @mou home up   end  pgup      kp-  @7   @8   @9   @*
  tab  lft  down rght pgdn      kp+  @4   @5   @6   @0
  bck  prtsc esc ins  fwd   XX  @.   @1   @2   @3   @,
            @func           _        del
)

(deflayer funckeys
  _    _    _    _    _   bspc  _    _    _    _    _
  @ndo vold mute volu _         XX   F7   F8   F9   F10
  lsft lmet lctl lalt @kz+      XX   F4   F5   F6   F11
  _    @cut @cpy @pst @kz- XX   XX   F1   F2   F3   F12
            _              _         _
)

(deflayer mousectl
  _     _     _     _     _   lrld  _    _    _    _    _
  XX    lalt  @mwu  S-tab tab       @cut mltp @mau mrtp XX
  @base @slw  @med  @fst  mlft      @cpy @mal @mad @mar @base
  @ndo  @mwl  @mwd  @mwr  XX   _    @pst mltp mmtp mrtp XX
              bspc            mlft       del
)

(defalias
	func (layer-toggle funckeys)
	kz- C-S-kp- ;; kitty zoom out
	kz+ C-S-=   ;; kitty zoom in

	;; mou (layer-toggle mousectl) ;; defined in base_lt_hrm.kbd
	mwu (mwheel-up    50 120)
	mwd (mwheel-down  50 120)
	mwl (mwheel-left  50 120)
	mwr (mwheel-right 50 120)
	mau (movemouse-accel-up    4 500 1 10)
	mad (movemouse-accel-down  4 500 1 10)
	mal (movemouse-accel-left  4 500 1 10)
	mar (movemouse-accel-right 4 500 1 10)
	slw (movemouse-speed 10)
	med (movemouse-speed 50)
	fst (movemouse-speed 200)
)
;; vim: set ft=lisp
